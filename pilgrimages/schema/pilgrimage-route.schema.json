{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christus-rex.github.io/temple-of-maat/pilgrimages/schema/pilgrimage-route.schema.json",
  "title": "Temple of Ma'at Pilgrimage Route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "routeId",
    "title",
    "subtitle",
    "privacy",
    "authorityLevels",
    "structureNote",
    "vow",
    "routeLaw",
    "sourceRefs",
    "gates"
  ],
  "properties": {
    "schema": { "const": "temple-of-maat/pilgrimage-route-v1" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "routeId": { "type": "string", "pattern": "^route\\.[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "privacy": { "const": "personal-state-device-local" },
    "authorityLevels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["HISTORICAL", "RECONSTRUCTED", "MODERN", "PERSONAL"] }
    },
    "structureNote": { "type": "string", "minLength": 1 },
    "vow": { "type": "string", "minLength": 1 },
    "routeLaw": { "type": "string", "minLength": 1 },
    "recordTitle": { "type": "string", "minLength": 1 },
    "recordSequence": { "type": "string", "minLength": 1 },
    "recordNote": { "type": "string", "minLength": 1 },
    "recordFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "authority", "locators"],
        "properties": {
          "id": { "type": "string", "pattern": "^source\\.[a-z0-9][a-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["HISTORICAL", "RECONSTRUCTED", "MODERN", "PERSONAL"] },
          "locators": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "title",
        "subtitle",
        "authorityLevels",
        "sourceRefs",
        "sourceAnchor",
        "teaching",
        "practice",
        "journalPrompts",
        "completionCondition"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-gate-[0-9]{2}$" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "authorityLevels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["HISTORICAL", "RECONSTRUCTED", "MODERN", "PERSONAL"] }
        },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source\\." } },
        "sourceAnchor": { "type": "string", "minLength": 1 },
        "teaching": { "type": "string", "minLength": 1 },
        "practice": { "type": "string", "minLength": 1 },
        "journalPrompts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "completionCondition": { "type": "string", "minLength": 1 },
        "stopCondition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
