{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://christus-rex.github.io/temple-of-maat/research/schema/scribe-workspace-state.v1.schema.json",
  "title": "Temple of Ma'at Nabu–Thoth Scribe Workspace State v1",
  "description": "Device-local private research threads that group Research Notebook entries, canonical anchors, and an append-only Scribe ledger without becoming public evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "privacy", "updatedAt", "threads"],
  "properties": {
    "schema": { "const": "temple-of-maat/scribe-workspace-state-v1" },
    "version": { "const": "1.0.0" },
    "privacy": { "const": "device-local-private" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "threads": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/thread" }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["endpoint", "claim", "passage", "source"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "ledgerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "reasoning", "sourceCitations", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^scribe\\.[a-z0-9-]+$" },
        "kind": { "enum": ["observation", "inference", "uncertainty", "dissent", "correction", "reply"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "reasoning": { "type": "string", "maxLength": 6000 },
        "sourceCitations": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/citation" }
        },
        "relatedLogId": { "type": "string", "pattern": "^scribe\\.[a-z0-9-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["correction", "reply"] } }, "required": ["kind"] },
          "then": { "required": ["relatedLogId"] }
        }
      ]
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "inquiry", "status", "notebookEntryIds", "anchors", "ledger", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^thread\\.[a-z0-9-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "inquiry": { "type": "string", "maxLength": 4000 },
        "status": { "enum": ["open", "paused", "closed"] },
        "notebookEntryIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^notebook\\.[a-z0-9-]+$" }
        },
        "anchors": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/citation" }
        },
        "ledger": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/ledgerEvent" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
